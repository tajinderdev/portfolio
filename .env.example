# ==============================================================================
# Portfolio Environment Variables Template
# ==============================================================================
# Copy this file to .env or .env.local for local configuration.
# For Vercel deployment, configure these in Project Settings -> Environment Variables.
#
# IMPORTANT SECURITY RULE:
# Never prefix server-side secrets with VITE_ to prevent leaking them to client bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side Email Delivery Configuration (Vercel Serverless & Dev Server)
# ------------------------------------------------------------------------------

# Resend API Key (Free tier: 3,000 emails/month, 100 emails/day, zero credit card required)
# Obtain your free key from: https://resend.com/api-keys
# NOTE: If omitted during local development or tests, the system runs in safe
# simulation mode and logs submissions to the console without failing.
RESEND_API_KEY=re_your_free_api_key_here

# Notification Receiver Email
# The private email address where contact form submissions will be delivered.
# (Never exposed to client bundles or git commits)
CONTACT_RECEIVER_EMAIL=your_email@example.com

# Notification Sender Email
# Default free Resend testing address (no custom domain required):
CONTACT_SENDER_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 2. Client-Side Public Configuration (Vite)
# ------------------------------------------------------------------------------

# Canonical site URL for metadata and Open Graph tags
VITE_SITE_URL=https://tajinder.dev
