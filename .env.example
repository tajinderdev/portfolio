# ==============================================================================
# Portfolio Environment Configuration (.env.example)
#
# IMPORTANT SECURITY NOTICE:
# - Variables prefixed with VITE_ are public and bundled into client JavaScript.
# - DO NOT place private API secrets, database credentials, or server keys in VITE_ variables.
# - Server-side secrets (for future backend / CI / CD operations) must NEVER start with VITE_.
# ==============================================================================

# Client-Side Configuration (Safe for browser bundle)
VITE_SITE_URL=https://tajinder.dev

# EmailJS Service Configuration (Client-side integration public keys)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Server-Side Only Placeholders (DO NOT expose with VITE_ prefix; for future serverless/backend)
# SERVER_API_SECRET_KEY=
# DATABASE_URL=
